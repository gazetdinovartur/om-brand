{% extends 'web/layout.html.twig' %}

{% set accountTab = accountTab|default('practice') %}
{% block title %}Своё место{% endblock %}

{% block body %}
<section class="library-page library-page--account" aria-labelledby="library-account-title">
    <div class="container library-shell">
        <nav class="case-crumb" aria-label="Навигация">
            <a href="{{ path('web_home') }}">Дом</a>
            <span class="case-crumb__sep" aria-hidden="true">/</span>
            <span class="case-crumb__current" aria-current="page">Своё место</span>
        </nav>

        <header class="library-head library-head--account">
            <h1 id="library-account-title">Своё место</h1>
            <p class="library-head__lead">
                {% if siteUser.displayName and siteUser.displayName != siteUser.email %}
                    <span class="library-head__name">{{ siteUser.displayName }}</span>
                {% endif %}
                {% if siteUser.displayName and siteUser.displayName != siteUser.email and (siteUser.email or siteUser.telegramUsername) %}
                    <span class="library-head__sep" aria-hidden="true">·</span>
                {% endif %}
                {% if siteUser.email %}{{ siteUser.email }}{% endif %}
                {% if siteUser.email and siteUser.telegramUsername %}
                    <span class="library-head__sep" aria-hidden="true">·</span>
                {% endif %}
                {% if siteUser.telegramUsername %}@{{ siteUser.telegramUsername }}{% endif %}
            </p>
        </header>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="site-alert site-alert--{{ label == 'danger' ? 'error' : 'success' }}" role="status">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <nav class="library-tabs" aria-label="Разделы своего места">
            <a
                class="library-tabs__link{% if accountTab == 'practice' %} is-active{% endif %}"
                href="{{ path('web_account', {tab: 'practice'}) }}"
                {% if accountTab == 'practice' %}aria-current="page"{% endif %}
            >Практика</a>
            <a
                class="library-tabs__link{% if accountTab == 'reading' %} is-active{% endif %}"
                href="{{ path('web_account', {tab: 'reading'}) }}"
                {% if accountTab == 'reading' %}aria-current="page"{% endif %}
            >Чтение</a>
            <a
                class="library-tabs__link{% if accountTab == 'keys' %} is-active{% endif %}"
                href="{{ path('web_account', {tab: 'keys'}) }}"
                {% if accountTab == 'keys' %}aria-current="page"{% endif %}
            >Ключи доступа</a>
        </nav>

        {% if accountTab == 'practice' %}
            <section class="library-account library-account--practice" aria-labelledby="library-practice-title">
                <h2 id="library-practice-title" class="library-account__section-title">Практика</h2>
                <p class="library-account__section-lead">Заказы и доступ к комнате встреч.</p>

                {% if hasPracticeRoomAccess %}
                    <p class="library-account__practice-cta">
                        <a class="btn btn-primary" href="{{ path('web_practice_room') }}">Войти в комнату практики</a>
                    </p>
                {% endif %}

                {% if practiceSessionsTotal > 0 %}
                    <p class="library-account__practice-balance">Осталось встреч: {{ practiceSessionsLeft }} из {{ practiceSessionsTotal }}</p>
                {% endif %}

                {% if practiceOffers is empty %}
                    <p class="library-account__panel-empty">Пока нет заказов. Можно оформить участие на <a href="{{ path('web_practice') }}">странице практики</a>.</p>
                {% else %}
                    <ul class="library-account__offer-list">
                        {% for offer in practiceOffers %}
                            <li class="library-account__offer-item">
                                <div class="library-account__offer-copy">
                                    <p class="library-account__offer-title">{{ offer.title }}</p>
                                    <p class="library-account__offer-meta">
                                        {% if offer.amount == 0 %}
                                            вход свободный
                                        {% else %}
                                            {{ offer.amountRubles|number_format(0, ',', ' ') }} ₽
                                        {% endif %}
                                        · {{ offer.status.label() }}
                                        · {{ offer.createdAt|date('d.m.Y') }}
                                        {% if offer.status.value == 'paid' and offer.sessionsTotal > 0 %}
                                            · осталось {{ offer.sessionsLeft }} из {{ offer.sessionsTotal }}
                                        {% endif %}
                                    </p>
                                </div>
                                <div class="library-account__offer-actions">
                                    {% if offer.status.value == 'pending' %}
                                        <a class="btn btn-primary" href="{{ practiceOfferUrls[offer.token] }}">Оплатить</a>
                                        <form method="post" class="library-account__offer-form" onsubmit="return confirm('Отменить эту заявку?')">
                                            <input type="hidden" name="action" value="cancel_offer">
                                            <input type="hidden" name="offer_token" value="{{ offer.token }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('practice_offer_cancel_offer_' ~ offer.token) }}">
                                            <button type="submit" class="library-account__offer-link">Отменить</button>
                                        </form>
                                    {% elseif offer.status.value == 'paid' %}
                                        <a class="library-account__offer-link" href="{{ path('web_practice_room') }}">В комнату</a>
                                    {% elseif offer.status.value in ['cancelled', 'expired'] %}
                                        <form method="post" class="library-account__offer-form" onsubmit="return confirm('Убрать заявку из списка?')">
                                            <input type="hidden" name="action" value="delete_offer">
                                            <input type="hidden" name="offer_token" value="{{ offer.token }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('practice_offer_delete_offer_' ~ offer.token) }}">
                                            <button type="submit" class="library-account__offer-link">Удалить</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if practiceRecordings is not empty %}
                    <section class="library-account__recordings" aria-labelledby="library-practice-recordings-title">
                        <h3 id="library-practice-recordings-title" class="library-account__subsection-title">Галерея записей</h3>
                        <ul class="library-account__gallery">
                            {% for session in practiceRecordings %}
                                <li class="library-account__gallery-item">
                                    <a class="library-account__gallery-card" href="{{ path('web_practice_room') }}">
                                        {% if session.posterUrl %}
                                            <img class="library-account__gallery-poster" src="{{ session.posterUrl }}" alt="" loading="lazy" width="320" height="180">
                                        {% else %}
                                            <span class="library-account__gallery-poster library-account__gallery-poster--empty" aria-hidden="true"></span>
                                        {% endif %}
                                        <span class="library-account__gallery-copy">
                                            <span class="library-account__gallery-title">{{ session.title }}</span>
                                            <span class="library-account__gallery-meta">
                                                {{ session.startsAt|date('d.m.Y') }}
                                                · {{ session.kind.label() }}
                                                {% if session.durationSeconds %}
                                                    · {{ (session.durationSeconds / 60)|round(0, 'floor') }} мин
                                                {% endif %}
                                            </span>
                                        </span>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}
            </section>
        {% elseif accountTab == 'reading' %}
            {% set openMarksPanel = recentBookmarks is not empty ? 'bookmarks' : (recentQuotes is not empty ? 'quotes' : (recentNotes is not empty ? 'notes' : 'bookmarks')) %}
            <section class="library-account library-account--marks" aria-labelledby="library-marks-title">
                <h2 id="library-marks-title" class="visually-hidden">Закладки, цитаты и заметки</h2>

                <div class="library-account__marks">
                    <details class="library-account__panel" {% if openMarksPanel == 'bookmarks' %}open{% endif %}>
                        <summary class="library-account__panel-summary">
                            <span class="library-account__panel-label">Закладки</span>
                            <span class="library-account__panel-meta">
                                <span class="library-account__panel-count">{{ recentBookmarks|length }}</span>
                                <span class="library-account__panel-icon" aria-hidden="true"></span>
                            </span>
                        </summary>
                        <div class="library-account__panel-body">
                            {% if recentBookmarks is empty %}
                                <p class="library-account__panel-empty">Пока пусто.</p>
                            {% else %}
                                <ul class="library-account__mark-list">
                                    {% for bookmark in recentBookmarks %}
                                        <li class="library-account__mark-item">
                                            <p class="library-account__mark-body">{{ bookmark.excerpt }}</p>
                                            <a
                                                class="library-account__mark-place"
                                                href="{{ path('web_library_read', {
                                                    bookSlug: bookmark.book.slug,
                                                    chapterSlug: bookmark.chapter.slug,
                                                    _fragment: bookmark.blockId
                                                }) }}"
                                            >{{ bookmark.book.title }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    </details>

                    <details class="library-account__panel" {% if openMarksPanel == 'quotes' %}open{% endif %}>
                        <summary class="library-account__panel-summary">
                            <span class="library-account__panel-label">Цитаты</span>
                            <span class="library-account__panel-meta">
                                <span class="library-account__panel-count">{{ recentQuotes|length }}</span>
                                <span class="library-account__panel-icon" aria-hidden="true"></span>
                            </span>
                        </summary>
                        <div class="library-account__panel-body">
                            {% if recentQuotes is empty %}
                                <p class="library-account__panel-empty">Пока пусто.</p>
                            {% else %}
                                <ul class="library-account__mark-list">
                                    {% for quote in recentQuotes %}
                                        <li class="library-account__mark-item">
                                            <blockquote class="library-account__mark-body">{{ quote.excerpt }}</blockquote>
                                            <a
                                                class="library-account__mark-place"
                                                href="{{ path('web_library_read', {
                                                    bookSlug: quote.book.slug,
                                                    chapterSlug: quote.chapter.slug,
                                                    _fragment: quote.blockId
                                                }) }}"
                                            >{{ quote.book.title }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    </details>

                    <details class="library-account__panel" {% if openMarksPanel == 'notes' %}open{% endif %}>
                        <summary class="library-account__panel-summary">
                            <span class="library-account__panel-label">Заметки</span>
                            <span class="library-account__panel-meta">
                                <span class="library-account__panel-count">{{ recentNotes|length }}</span>
                                <span class="library-account__panel-icon" aria-hidden="true"></span>
                            </span>
                        </summary>
                        <div class="library-account__panel-body">
                            {% if recentNotes is empty %}
                                <p class="library-account__panel-empty">Пока пусто.</p>
                            {% else %}
                                <ul class="library-account__mark-list">
                                    {% for note in recentNotes %}
                                        <li class="library-account__mark-item">
                                            <p class="library-account__mark-body">{{ note.body }}</p>
                                            <a
                                                class="library-account__mark-place"
                                                href="{{ path('web_library_read', {
                                                    bookSlug: note.book.slug,
                                                    chapterSlug: note.chapter.slug,
                                                    _fragment: note.blockId
                                                }) }}"
                                            >{{ note.book.title }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    </details>
                </div>
            </section>
        {% else %}
            <section class="library-account" aria-labelledby="library-keys-title">
                <div class="library-account__intro">
                    <h2 id="library-keys-title" class="visually-hidden">Ключи доступа</h2>
                    <p>
                        Face ID, Touch ID или PIN — чтобы входить без кода и Telegram.
                        Для надёжности добавьте второй ключ на другом устройстве.
                    </p>
                </div>

                <div
                    class="library-account__add"
                    data-passkey-register
                    data-options-url="{{ path('webauthn.controller.creation.request.site') }}"
                    data-result-url="{{ path('webauthn.controller.creation.response.site') }}"
                >
                    <button type="button" class="btn btn-primary" data-passkey-register-button>
                        Добавить ключ на этом устройстве
                    </button>
                    <p class="library-account__status" data-passkey-status role="status" aria-live="polite"></p>
                </div>

                {% if credentials is empty %}
                    <p class="library-account__empty">Ключей пока нет — добавьте первый, когда будете на своём устройстве.</p>
                {% else %}
                    <ul class="library-account__list">
                        {% for credential in credentials %}
                            <li class="library-account__key">
                                <form method="post" class="library-account__rename">
                                    <input type="hidden" name="action" value="rename">
                                    <input type="hidden" name="credential_id" value="{{ credential.id }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('site_passkey_rename_' ~ credential.id) }}">
                                    <label class="visually-hidden" for="passkey-label-{{ credential.id }}">Название ключа</label>
                                    <input
                                        id="passkey-label-{{ credential.id }}"
                                        type="text"
                                        name="label"
                                        value="{{ credential.label }}"
                                        maxlength="120"
                                        required
                                    >
                                    <button type="submit" class="btn btn-outline">Сохранить</button>
                                </form>
                                <div class="library-account__key-meta">
                                    <p>
                                        Добавлен {{ credential.createdAt|date('d.m.Y H:i') }}
                                        {% if credential.lastUsedAt %}
                                            · использован {{ credential.lastUsedAt|date('d.m.Y H:i') }}
                                        {% endif %}
                                    </p>
                                    <form method="post" onsubmit="return confirm('Удалить этот ключ доступа?')">
                                        <input type="hidden" name="action" value="delete">
                                        <input type="hidden" name="credential_id" value="{{ credential.id }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('site_passkey_delete_' ~ credential.id) }}">
                                        <button type="submit" class="library-account__delete">Удалить</button>
                                    </form>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        {% endif %}

        <footer class="library-account__footer">
            <a href="{{ path('web_home') }}">← На главную</a>
            <a href="{{ path('web_library') }}">Библиотека</a>
            <a href="{{ path('web_library_logout') }}">Выйти</a>
        </footer>
    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if accountTab == 'keys' %}
        <script src="{{ asset('js/passkey.js') }}" defer></script>
    {% endif %}
{% endblock %}
