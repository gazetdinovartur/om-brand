{% extends 'emails/_brand_shell.html.twig' %}

{% block email_title %}Код входа · {{ siteName }}{% endblock %}
{% block email_badge %} · Вход{% endblock %}

{% block email_header %}
<tr>
    <td style="padding:32px 32px 12px;">
        <p style="margin:0 0 10px;font-size:12px;line-height:1.4;letter-spacing:0.12em;text-transform:uppercase;color:#9f5d18;">
            Своё место на сайте
        </p>
        <h1 style="margin:0;font-size:28px;line-height:1.2;font-weight:600;color:#1f1a14;">
            Код для входа
        </h1>
    </td>
</tr>
{% endblock %}

{% block email_body %}
    <p style="margin:0 0 16px;">
        Вы запросили вход в библиотеку на сайте <strong style="font-weight:600;color:#1f1a14;">{{ siteName }}</strong>.
    </p>
    <p style="margin:0 0 18px;">
        Введите этот код на странице входа. Он действует {{ ttlMinutes }} минут.
    </p>
    <div style="margin:0 0 20px;padding:18px 16px;border-radius:14px;background:rgba(232,168,73,0.12);text-align:center;">
        <span style="font-size:32px;letter-spacing:0.28em;font-weight:700;color:#1f1a14;">{{ code }}</span>
    </div>
    <p style="margin:0;font-size:14px;line-height:1.6;color:#6f6558;">
        Если вы не запрашивали код, просто проигнорируйте это письмо.
    </p>
{% endblock %}
