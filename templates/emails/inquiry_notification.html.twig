{% extends 'emails/_brand_shell.html.twig' %}

{% block email_title %}Новая заявка #{{ inquiry.id }}{% endblock %}

{% block email_badge %} · Заявка{% endblock %}

{% block email_header %}
<tr>
    <td style="padding:32px 32px 12px;">
        <p style="margin:0 0 10px;font-size:12px;line-height:1.4;letter-spacing:0.12em;text-transform:uppercase;color:#9f5d18;">
            Новая заявка
        </p>
        <h1 style="margin:0;font-size:28px;line-height:1.2;font-weight:600;color:#1f1a14;">
            #{{ inquiry.id }} · {{ inquiry.name }}
        </h1>
    </td>
</tr>
{% endblock %}

{% block email_body %}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="font-size:15px;line-height:1.65;">
    <tr>
        <td style="padding:8px 0;color:#6f6558;width:120px;vertical-align:top;">Имя</td>
        <td style="padding:8px 0;color:#1f1a14;font-weight:600;">{{ inquiry.name }}</td>
    </tr>
    <tr>
        <td style="padding:8px 0;color:#6f6558;vertical-align:top;">Контакт</td>
        <td style="padding:8px 0;color:#1f1a14;">{{ inquiry.contactType.label() }} · {{ inquiry.contact }}</td>
    </tr>
    <tr>
        <td style="padding:8px 0;color:#6f6558;vertical-align:top;">Тип</td>
        <td style="padding:8px 0;color:#1f1a14;">{{ inquiry.inquiryType.label() }}</td>
    </tr>
    <tr>
        <td style="padding:8px 0;color:#6f6558;vertical-align:top;">Сообщение</td>
        <td style="padding:8px 0;color:#1f1a14;white-space:pre-wrap;">{{ messageText }}</td>
    </tr>
    {% if inquiry.hasAttachment %}
    <tr>
        <td style="padding:8px 0;color:#6f6558;vertical-align:top;">Файл</td>
        <td style="padding:8px 0;color:#1f1a14;">{{ inquiry.attachmentOriginalName }}</td>
    </tr>
    {% endif %}
</table>

<table role="presentation" cellspacing="0" cellpadding="0" style="margin:20px 0 8px;">
    <tr>
        <td style="border-radius:999px;background:#c87828;">
            <a href="{{ adminUrl }}" style="display:inline-block;padding:14px 22px;color:#fffdf9;text-decoration:none;font-size:15px;font-weight:600;letter-spacing:0.01em;">
                Открыть в админке
            </a>
        </td>
    </tr>
</table>

<div style="padding:14px 16px;border-radius:14px;background:rgba(232,168,73,0.12);color:#5d503f;font-size:14px;line-height:1.6;">
    Заявка пришла с формы на {{ siteDomain }}. Ответьте клиенту удобным способом.
</div>
{% endblock %}
