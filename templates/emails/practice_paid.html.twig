{% extends 'emails/_brand_shell.html.twig' %}

{% block email_title %}Оплата получена · доступ к комнате{% endblock %}

{% block email_badge %} · Практика{% endblock %}

{% block email_header %}
<tr>
    <td style="padding:32px 32px 12px;">
        <p style="margin:0 0 10px;font-size:12px;line-height:1.4;letter-spacing:0.12em;text-transform:uppercase;color:#9f5d18;">
            Регуляция и регулярность
        </p>
        <h1 style="margin:0;font-size:26px;line-height:1.25;font-weight:600;color:#1f1a14;">
            Оплата получена
        </h1>
    </td>
</tr>
{% endblock %}

{% block email_body %}
<p style="margin:0 0 16px;color:#3a3127;">
    Привет{{ inquiry and inquiry.name ? ', '~inquiry.name : '' }}. Оплата за «{{ offer.title }}» прошла
    {% if amountRubles > 0 %}({{ amountRubles|number_format(0, ',', ' ') }} ₽){% endif %}.
</p>
<p style="margin:0 0 16px;color:#3a3127;">
    Доступ к комнате практики открыт.
</p>
<p style="margin:0 0 24px;">
    <a href="{{ loginUrl }}" style="display:inline-block;padding:12px 22px;border-radius:999px;background:#8c2f3a;color:#fff8f6;text-decoration:none;font-weight:600;">
        Войти в комнату
    </a>
</p>
<p style="margin:0;font-size:14px;color:#6f6558;">
    Если уже вошёл на сайт: <a href="{{ roomUrl }}" style="color:#8c2f3a;">{{ roomUrl }}</a><br>
    Заказы: <a href="{{ accountUrl }}" style="color:#8c2f3a;">Своё место → Практика</a>
</p>
{% endblock %}
