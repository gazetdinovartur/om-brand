<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block email_title %}{{ siteName }}{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background:#f7f3eb;font-family:Montserrat,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#1f1a14;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f7f3eb;padding:28px 12px;">
    <tr>
        <td align="center">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:580px;">
                <tr>
                    <td style="padding:0 0 16px;text-align:center;">
                        <span style="display:inline-block;width:56px;height:56px;line-height:56px;border-radius:999px;background:linear-gradient(145deg,#f6d7a8,#e8a849);color:#5c3b12;font-size:22px;font-weight:700;text-align:center;box-shadow:0 18px 50px rgba(200,120,40,0.18);">
                            {{ siteName|slice(0, 1)|upper }}
                        </span>
                        <p style="margin:12px 0 0;font-size:12px;line-height:1.4;letter-spacing:0.12em;text-transform:uppercase;color:#6f6558;">
                            {{ siteDomain }}{% block email_badge %} · {{ siteName }}{% endblock %}
                        </p>
                    </td>
                </tr>
                <tr>
                    <td>
                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#fffdf9;border:1px solid rgba(31,26,20,0.08);border-radius:20px;box-shadow:0 18px 50px rgba(31,26,20,0.08);overflow:hidden;">
                            <tr>
                                <td style="height:8px;background:linear-gradient(90deg,#c87828,#e8a849);font-size:0;line-height:0;">&nbsp;</td>
                            </tr>
                            {% block email_header %}{% endblock %}
                            <tr>
                                <td style="padding:0 32px 8px;font-size:16px;line-height:1.7;color:#3a3127;">
                                    {% block email_body %}{% endblock %}
                                </td>
                            </tr>
                            {% block email_footer_row %}{% endblock %}
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
