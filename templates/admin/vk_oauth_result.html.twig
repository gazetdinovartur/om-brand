<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>VK OAuth</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<main class="container py-5" style="max-width: 32rem">
    {% if ok %}
        <div class="alert alert-success">{{ message }}</div>
        {% if userId %}
            <p class="text-muted small mb-3">user_id: {{ userId }} — при необходимости добавьте <code>VK_OWNER_ID={{ userId }}</code> в .env</p>
        {% endif %}
    {% else %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endif %}
    <a class="btn btn-primary" href="{{ path('admin') }}">В админку</a>
</main>
</body>
</html>
