{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}
{% set session = entity.instance %}
<div class="practice-session-howto">
    <ol class="mb-2" style="padding-left: 1.25rem; margin: 0;">
        <li>Участники — <strong>Комната на сайте</strong>.</li>
        <li><strong>В эфир</strong> → статус «эфир».</li>
        <li>Ты — кнопка <strong>Ведущий (JWT)</strong> (host-токен в Speak).</li>
        <li>После — <strong>Встреча завершена</strong> или webhook. Список звонков — <strong>Звонки</strong>.</li>
        <li>Срыв без удаления карточки — <strong>Отменить комнату</strong>.</li>
    </ol>
    {% if not session.kinescopeRoomId and not session.kinescopeEventId %}
        <p class="text-danger mb-0">Сначала «Создать комнату».</p>
    {% endif %}
</div>
