<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <title>Звонки · {{ session.title }}</title>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.svg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="{{ asset('css/admin-custom.css') }}" rel="stylesheet">
</head>
<body class="bg-light">
<main class="container py-4" style="max-width: 46rem;">
    <a class="d-inline-block mb-3 text-decoration-none" href="{{ backUrl }}">← К сессии</a>

    <h1 class="h3 mb-1">Звонки и записи</h1>
    <p class="text-secondary mb-4">{{ session.title }}{% if session.kinescopeRoomCode %} · код {{ session.kinescopeRoomCode }}{% endif %}</p>

    {% if session.kinescopeVideoId %}
        <div class="alert alert-secondary">
            Video ID на карточке:
            <code>{{ session.kinescopeVideoId }}</code>
            · <a href="https://kinescope.io/{{ session.kinescopeVideoId }}" target="_blank" rel="noopener">открыть</a>
        </div>
    {% endif %}

    {% if error %}
        <div class="alert alert-danger" role="alert">Не удалось загрузить звонки: {{ error }}</div>
    {% elseif calls is empty %}
        <p class="text-secondary">Пока нет звонков в этой комнате (или комната уже отменена).</p>
    {% else %}
        <div class="table-responsive bg-white border rounded">
            <table class="table table-sm mb-0">
                <thead>
                <tr>
                    <th>Call ID</th>
                    <th>Создан</th>
                    <th>Транскрипт</th>
                </tr>
                </thead>
                <tbody>
                {% for call in calls %}
                    <tr>
                        <td><code class="small">{{ call.id }}</code></td>
                        <td class="small text-secondary">{{ call.created_at ?? '—' }}</td>
                        <td class="small">{{ call.transcript_id ? call.transcript_id : '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if not jwtConfigured %}
        <p class="text-warning small mt-4 mb-0">Speak JWT не настроен — кнопка «Ведущий» откроет комнату без host-токена. См. <code>app:kinescope:setup-jwt</code>.</p>
    {% endif %}
</main>
</body>
</html>
