###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_generate_random_32_chars
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://site:change_me_db_password@mysql:3306/site?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# null://null — письма не отправляются. Local docker: smtp://mailpit:1025
# Prod example: smtp://user:pass@smtp.example.com:587
MAILER_DSN=null://null
# Отправитель (должен совпадать с логином SMTP). Пример: info@arturlun.ru
MAILER_FROM=
###< symfony/mailer ###

# Публичный URL сайта для canonical и Open Graph (prod обязательно)
# Prod: https://arturlun.ru
# Local docker: http://localhost:8085
APP_SITE_URL=http://localhost:8085

# Passkey / WebAuthn. На prod RP ID — домен без схемы, origin — полный HTTPS URL.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="Артур · админка"
WEBAUTHN_ALLOWED_ORIGIN=http://localhost:8085

# Версия статики (css/js). Меняйте при каждом релизе фронта, чтобы сбросить кэш браузеров.
ASSETS_VERSION=20261013j

# Web Push (VAPID). Сгенерировать: php -r 'require "vendor/autoload.php"; print_r(Minishlink\WebPush\VAPID::createVapidKeys());'
# subject — mailto: или https:// URL сайта
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@example.com

# Админ (используется app:seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong_password

# Telegram-уведомления о заявках (опционально)
TELEGRAM_BOT_TOKEN=
# Username бота без @ (справки/доки; для входа в библиотеку не нужен)
TELEGRAM_BOT_USERNAME=
# OAuth 2.0 / OIDC Login (BotFather → Login Widget → Client ID/Secret)
# Redirect URI: {DEFAULT_URI}/library/login/telegram/callback
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_CHAT_ID=
# Telegram-канал для кросспоста хроники (отдельно от чата заявок)
TELEGRAM_CHANNEL_ID=
# TELEGRAM_CHANNEL_ENABLED=1  # необязательно: включается само, если заданы bot + channel

# VK кросспост хроники в сообщество (oauth user-токен: Standalone + blank.html)
VK_APP_ID=
VK_APP_SECRET=
# либо устаревшее имя:
# VK_SECRET_KEY=
VK_SERVICE_TOKEN=
# либо VK_SERVICE_KEY / VK_SERVISE_KEY
VK_COMMUNITY_TOKEN=
VK_USER_ACCESS_TOKEN=
# Кросспост: сообщество (отрицательный id или короткое имя)
VK_OWNER_ID=
# Импорт стены → хроника: личная страница (user id без минуса). Если пусто — берётся VK_OWNER_ID.
VK_SYNC_OWNER_ID=
VK_CROSSPOST_ENABLED=0

# Шаблон ссылки СБП (опционально; приоритет у поля в админке → Настройки)
# Плейсхолдеры: {amount_rubles}, {amount}, {token}, {title}, {id}
SBP_PAYMENT_URL_TEMPLATE=

# ЮKassa (оплата практики). Секреты только в .env / на сервере — не в git.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Kinescope: API + webhook. Секреты только в .env / на сервере.
KINESCOPE_API_TOKEN=
# UUID проекта/папки (или имя — клиент попробует резолвить через API), напр. arturlun
KINESCOPE_PARENT_ID=
# UUID пользователя-владельца Speak в Kinescope (нужен для создания комнат)
KINESCOPE_SPEAK_OWNER_ID=
# Speak host JWT: php bin/console app:kinescope:setup-jwt → путь к PEM + kid
KINESCOPE_JWT_PRIVATE_KEY_PATH=
KINESCOPE_JWT_KID=
# HTTP Basic для входящего webhook (сам задаёшь в подписке Kinescope)
KINESCOPE_WEBHOOK_USER=
KINESCOPE_WEBHOOK_PASSWORD=

# Практика на сайте: 0 = скрыта с карты/меню, /practice только для ROLE_ADMIN; 1 = публично.
PRACTICE_PUBLIC_ENABLED=0

# OmPlayer embed (кейсы с голосом)
OM_PLAYER_SCRIPT_URL=https://music.arturlun.ru/build/player/om-player.iife.js
OM_PLAYER_API_BASE=https://music.arturlun.ru/api/v1

# Тяжёлые экспорты вне репо (Instagram / Google Photos) — пути на машине
# CONTENT_INSTAGRAM_PATH=/Users/you/Downloads/instagram-….zip
# CONTENT_GOOGLE_PHOTOS_PATH=/Users/you/Downloads/takeout-….zip
CONTENT_INSTAGRAM_PATH=
CONTENT_GOOGLE_PHOTOS_PATH=

# Docker / локальная разработка
DEFAULT_URI=http://localhost:8085
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=site
MYSQL_USER=site
MYSQL_PASSWORD=change_me_db_password

# Деплой / sync с машины разработчика (не на сервере)
# DEPLOY_SSH=c502022@91.201.52.29
# DEPLOY_REMOTE_ROOT=/home/c502022/arturlun.ru/om-brand
# DEPLOY_SSH_PORT=22
# DEPLOY_SSH_IDENTITY=~/.ssh/arturlun_deploy
